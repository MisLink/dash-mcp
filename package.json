{
  "name": "dash-mcp",
  "version": "1.0.0",
  "description": "MCP server for Dash documentation browser — supports stdio and HTTP transport with LAN proxy",
  "bin": {
    "dash-mcp": "./bin/dash-mcp.mjs"
  },
  "files": [
