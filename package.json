    "http-proxy": "^1.18.1",
    "jiti": "^2.7.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.15.23",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
